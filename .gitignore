# Terraform state — never commit, may contain secrets
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
crash.log
crash.*.log

# Variable files — may contain tenant URLs, tokens, and names specific to
# your organization.
# Only the *.example templates are tracked.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Plan output. The examples use `-out=tf.plan`, so plain *.plan must be
# ignored too — a saved plan can contain variable values.
*.tfplan
*.tfplan.*
*.plan

# Override files (local-only experiments)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc

# macOS
.DS_Store
